{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".tmp-runtime",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/runtime/**/*.ts", "src/features/capture-feedback.ts"]
}
