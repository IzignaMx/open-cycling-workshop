{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".tmp-kernel",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/access-kernel/**/*.ts"]
}
