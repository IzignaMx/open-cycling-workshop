{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".tmp-inventory",
    "rootDir": ".",
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["src/features/inventory/**/*.ts", "src/features/inventory/CatalogPage.tsx"]
}
