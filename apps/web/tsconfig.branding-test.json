{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".tmp-branding",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/features/branding/**/*.ts",
    "src/branding/**/*.ts",
    "src/personalization/resolution.ts"
  ]
}
