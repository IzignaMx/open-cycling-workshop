{
	# Even without access logging, upstream failures log the original request.
	# Remove only inventory queries at encoding time, including equivalent
	# percent-encoded paths. Keep method/path/status and other runtime errors.
	log default {
		format filter {
			request>uri regexp `^((?:/|%2[fF])(?:a|%61)(?:p|%70)(?:i|%69)(?:/|%2[fF])(?:v|%76)(?:1|%31)(?:/|%2[fF])(?:i|%69)(?:n|%6[eE])(?:v|%76)(?:e|%65)(?:n|%6[eE])(?:t|%74)(?:o|%6[fF])(?:r|%72)(?:y|%79)(?:(?:/|%2[fF])[^?]*)?)\?.*$` `${1}`
			wrap json
		}
	}
	admin off
	auto_https off
}

import /etc/caddy/routes.caddy

http://:8080 {
	import ocwp_routes
}

http://:8081 {
	bind 127.0.0.1
	respond /edge-health "ok" 200
}
