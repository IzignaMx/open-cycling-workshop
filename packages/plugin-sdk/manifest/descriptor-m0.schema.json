          "enum": ["official-build", "external-connector"]
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      }
    },
    "events": {
      "type": "object",
