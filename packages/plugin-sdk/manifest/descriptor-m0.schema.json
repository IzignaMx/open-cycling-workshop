      "required": ["subscribes"],
      "properties": {
        "subscribes": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      }
    },
    "secrets": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns"],
      "properties": {
        "owns": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      }
